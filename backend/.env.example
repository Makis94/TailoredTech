# Local development environment. Copy to .env and adjust as needed.
# See docker-compose.yml at the repo root for matching Postgres/MinIO credentials.

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://dataroom:dataroom@localhost:5432/dataroom?schema=public"

# --- App ------------------------------------------------------------------
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# --- Auth -------------------------------------------------------------
# openssl rand -base64 32
JWT_SECRET="dev-only-change-me-dev-only-change-me"
JWT_EXPIRES_IN="7d"

# --- Object storage (S3-compatible) ---------------------------------------
# Local dev talks to the MinIO container from docker-compose.yml.
# In production point these at a real bucket (AWS S3, Cloudflare R2, etc).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="dataroom-files"
S3_ACCESS_KEY_ID="dataroom"
S3_SECRET_ACCESS_KEY="dataroom123"
# MinIO needs path-style URLs (bucket.s3.amazonaws.com doesn't resolve locally).
# Set to "false" when pointing at real AWS S3.
S3_FORCE_PATH_STYLE=true
